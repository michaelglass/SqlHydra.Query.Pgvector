<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <WarnOn>3390;1104;0020;0044;0025;3391;0067;0021</WarnOn>
    <NoWarn>$(NoWarn);NU1605;MSB3277;NETSDK1188;FS1182</NoWarn>
    <!-- FS1182: the sqlFn stub parameters (cosine_distance etc.) are intentional pattern
         markers for the visitor — they exist so users can pass values; the visitor matches
         the call-site shape rather than evaluating the body. -->
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>SqlHydra.Query.Pgvector</PackageId>
    <Version>0.1.0-alpha.4</Version>
    <Authors>Michael Glass</Authors>
    <Description>pgvector distance functions for SqlHydra.Query — cosine, L2, and inner product distance operators for `select` projections and `ORDER BY`, plus a code-generation type mapping (PgvectorTypeMapping) that maps the PostgreSQL `vector` column to `Pgvector.Vector`.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/michaelglass/SqlHydra.Query.Pgvector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Disable SourceLink when no .git directory exists (jj without colocated git).
         EnableSourceControlManagerQueries=false is required alongside EnableSourceLink=false:
         without it the Microsoft.Build.Tasks.Git "InitializeSourceControlInformation" target
         still runs and hard-fails ("Unable to locate repository") in a non-colocated jj
         checkout. This guard only fires when .git is absent, so CI and colocated checkouts
         (where .git exists) keep full SourceLink source-debugging metadata. -->
    <EnableSourceLink Condition="!Exists('$(MSBuildThisFileDirectory)../../.git')">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="!Exists('$(MSBuildThisFileDirectory)../../.git')">false</EnableSourceControlManagerQueries>
    <PackageTags>F# fsharp sql sqlhydra pgvector vector similarity postgresql</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="PgvectorExtensions.fs" />
    <Compile Include="TypeMapping.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The only reference needed: this package carries both the extensibility seam the
         operators use and the SqlHydra.Domain codegen types TypeMapping.fs implements
         against (bundled as lib/<tfm>/SqlHydra.Domain.dll).
         Must stay at or above beta.2: beta.1 throws on aggregates over an expression
         (e.g. sumBy(caseWhen ...)). NuGet resolves transitive deps to the lowest satisfying
         version, so a lower floor would hand downstream consumers the broken build. -->
    <PackageReference Include="SqlHydra.Query" Version="4.1.0-beta.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Per-TFM FSharp.Core floors, set to the lowest version each TFM supports (mirroring
         SqlHydra.Query's). A PackageReference version is a minimum, so a low floor keeps us
         compatible with a broad range. Left implicit, the F# SDK floats it to whatever the
         build SDK bundles — a non-deterministic, needlessly high floor that breaks consumers
         pinned lower. -->
    <PackageReference Update="FSharp.Core" Version="6.0.7" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Update="FSharp.Core" Version="8.0.100" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Update="FSharp.Core" Version="9.0.201" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Update="FSharp.Core" Version="10.1.201" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>
</Project>
